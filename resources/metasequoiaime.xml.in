<?xml version="1.0" encoding="UTF-8"?>
<component>
  <name>com.houko.inputmethod.MetasequoiaImeLinux</name>
  <description>Metasequoia IME IBus component</description>
  <exec>@CMAKE_INSTALL_FULL_LIBEXECDIR@/metasequoia-ime-ibus --ibus</exec>
  <version>@PROJECT_VERSION@</version>
  <author>Metasequoia IME contributors</author>
  <license>GPL-3.0-only</license>
  <homepage>https://github.com/metasequoiaime/MSIME-Linux</homepage>
  <textdomain>metasequoiaime</textdomain>
  <engines>
    <engine>
      <name>metasequoiaime</name>
      <longname>Metasequoia IME</longname>
      <description>Chinese and Japanese input with Quanpin, Shuangpin, Wubi and Romaji schemes</description>
      <language>zh</language>
      <license>GPL-3.0-only</license>
      <author>Metasequoia IME contributors</author>
      <layout>us</layout>
    </engine>
  </engines>
</component>
